# ---------------------------------------------------------------- database (Supabase)
# Supabase dashboard > Connect > "Session pooler" (IPv4, works from any server).
# Project ref for this project: gculrkdumuuejsiqsniq. Copy the exact host from the dashboard;
# the region part (aws-0-ap-southeast-1 ...) depends on where the project was created.
DATABASE_URL=postgresql://postgres.gculrkdumuuejsiqsniq:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# require (default for remote hosts) | off (local Postgres). Optional CA file to verify against:
# DATABASE_SSL=require
# DATABASE_CA_CERT=/app/certs/supabase-ca.crt
DATABASE_POOL_MAX=5

PORT=8080

# ---------------------------------------------------------------- sign-in
# Signs session tokens. Generate once: openssl rand -hex 32   (changing it signs everyone out)
SESSION_SECRET=

# Google OAuth client IDs, comma-separated. The WEB client ID MUST come first (the web app
# and Android both use it); add the iOS client ID after it when you build for iOS.
GOOGLE_CLIENT_ID=

# Apple: your app's bundle ID (iOS). Leave empty until the iOS build.
APPLE_CLIENT_ID=

# Lets anyone sign in with any email. Development only: keep false in production.
ALLOW_DEV_AUTH=false

# ---------------------------------------------------------------- housekeeping
# Deleted links/folders are kept this many days so every device hears about the delete.
TOMBSTONE_DAYS=60
# Unaccepted board invitations expire after this many days.
INVITE_DAYS=60
