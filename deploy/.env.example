# ================================================================ Shareby production settings
# Copy to deploy/.env and fill in. Never commit the real file.

# ---------------------------------------------------------------- public address
# The domain people open (no https://, no trailing slash).
SHAREBY_DOMAIN=shareby.example.com
# Only for the Cloudflare Tunnel option (Zero Trust > Networks > Tunnels > your tunnel > token).
CLOUDFLARE_TUNNEL_TOKEN=

# ---------------------------------------------------------------- Supabase database
# Supabase dashboard > your project > Connect > "Session pooler". Use the string exactly as
# shown and put your database password in it. Session pooler = IPv4 + session mode (needed).
DATABASE_URL=postgresql://postgres.gculrkdumuuejsiqsniq:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_POOL_MAX=5

# ---------------------------------------------------------------- sign-in
# openssl rand -hex 32     (changing it later signs everyone out)
SESSION_SECRET=
# Google Cloud > APIs & Services > Credentials. WEB client ID first, then iOS (later), comma-separated.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
ALLOW_DEV_AUTH=false

# ---------------------------------------------------------------- housekeeping
TOMBSTONE_DAYS=60
INVITE_DAYS=60
